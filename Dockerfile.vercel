# syntax=docker/dockerfile:1
# Keep this file at the repository root: Vercel uses its directory as the context.
FROM gcc:14-bookworm AS native
WORKDIR /source
RUN --mount=type=bind,source=shared,target=/source/shared \
    --mount=type=bind,source=engines/engine-1,target=/source/engines/engine-1 \
    g++ -std=c++20 -O2 -static -s -Ishared/include -Ishared/third_party \
    engines/engine-1/main.cpp engines/engine-1/protocol.cpp engines/engine-1/search.cpp \
    shared/src/geometry.cpp shared/src/hex_rules.cpp shared/variants/*.cpp \
    -o /engine-one

FROM node:24-bookworm-slim AS api-build
WORKDIR /app
# One source layer keeps builds small with Docker's copy-based storage driver.
# .dockerignore excludes dependencies, generated files, Git, and environment files.
COPY . .
RUN --mount=type=secret,id=proxy_ca \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --workspace @ion/api --include-workspace-root --strict-ssl=true; \
    npm run build:api; \
    npm prune --omit=dev --workspace @ion/api --include-workspace-root

FROM node:24-bookworm-slim
ENV NODE_ENV=production PORT=80 HEXARS_ENGINE_PATH=/app/engine-one
WORKDIR /app
COPY --from=api-build --chown=node:node /app/node_modules ./node_modules
COPY --from=api-build --chown=node:node /app/api/dist/server.mjs ./server.mjs
COPY --from=native --chown=node:node /engine-one ./engine-one
USER node
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s \
  CMD node -e 'fetch("http://127.0.0.1:"+process.env.PORT+"/health").then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))'
CMD ["node", "server.mjs"]
