{
  "name": "ion",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "manager",
    "api",
    "gateway",
    "cloud/engine-worker"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:engine": "node scripts/build-native.mjs",
    "build:cloud": "node scripts/build-native.mjs --cloud",
    "build": "npm run build:engine && npm run build --workspace web",
    "dev": "npm run dev --workspace web",
    "manager": "npm run start --workspace manager",
    "test:native": "node scripts/build-native.mjs --test",
    "test:puzzles": "tsx tests/puzzles/verify.mts",
    "test:manager": "npm run build:positional && npm run build:defensive && npm run build:materialist && npm run build:unconventional && npm run build:universal && node --test tests/engine/*.test.mjs",
    "test:web": "npm run test --workspace web",
    "test": "npm run test:native && npm run test:search && npm run test:manager && npm run test:web && npm run test:api",
    "package:source": "node scripts/package-source.mjs",
    "build:web": "npm run build --workspace web",
    "build:api": "npm run build --workspace @ion/api",
    "api": "npm run dev --workspace @ion/api",
    "test:api": "npm run test --workspace @ion/api",
    "check:engine-worker": "npm run build --workspace @ion/engine-worker",
    "check:gateway": "npm run check --workspace @ion/gateway",
    "build:positional": "node scripts/build-positional.mjs",
    "test:positional": "npm run build:positional && node --test tests/engine/positional.test.mjs",
    "build:defensive": "node scripts/build-defensive.mjs",
    "build:engines": "npm run build:engine && npm run build:positional && npm run build:defensive && npm run build:materialist && npm run build:unconventional && npm run build:universal",
    "test:defensive": "npm run build:defensive && node --test tests/engine/defensive.test.mjs",
    "test:search": "node scripts/test-search-engines.mjs",
    "build:materialist": "node scripts/build-materialist.mjs",
    "build:unconventional": "node scripts/build-unconventional.mjs",
    "test:materialist": "npm run build:materialist && node --test tests/engine/materialist.test.mjs",
    "test:unconventional": "npm run build:unconventional && node --test tests/engine/unconventional.test.mjs",
    "build:universal": "node scripts/build-universal.mjs",
    "test:universal": "npm run build:universal && node --test tests/engine/universal.test.mjs"
  }
}
