{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "gateway": {
      "root": "gateway",
      "runtime": "node",
      "entrypoint": "server.ts",
      "devCommand": "npm run dev",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "HEXARS_API_URL"
        }
      ]
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/:variant(glinski|mccooey|shafran)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "gateway" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
