{
  "name": "@hexars/api",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "superjson": "^2.2.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
