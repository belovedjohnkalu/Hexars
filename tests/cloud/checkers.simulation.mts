import {createCheckers,readCheckers,generateCheckersMoves,advanceCheckers,checkersResult,applyCheckersMove,checkersView} from '../../cloud/floot/helpers/checkersRules.tsx';
import {searchCheckers} from '../../cloud/floot/helpers/checkersRuntime.tsx';
let seed=59;const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};
for(const variant of ['hexdame','kruzno'] as const){let total=0,ended=0,capped=0,kings=0;const reasons:Record<string,number>={};for(let game=0;game<30;game++){let s=createCheckers(variant);for(let turn=0;turn<1500;turn++){const legal=generateCheckersMoves(s),result=checkersResult(s,legal);if(result.status!=='ongoing'){ended++;reasons[result.reason]=(reasons[result.reason]||0)+1;break;}if(turn===1499)capped++;const m=legal[Math.floor(random()*legal.length)];s=applyCheckersMove(s,m).state;readCheckers(s);if(s.pieces.some(p=>p.type==='draughts-king'))kings++;total++;}}console.log(JSON.stringify({kind:'seeded-random',variant,games:30,ended,capped,total,kings,reasons}));}
for(const variant of ['hexdame','kruzno'] as const){let s=createCheckers(variant),maxMs=0,turns=0;for(;turns<1000;turns++){if(checkersResult(s).status!=='ongoing')break;const selected=await searchCheckers(s,1);maxMs=Math.max(maxMs,selected.diagnostics.timeMs);s=applyCheckersMove(s,selected.move).state;readCheckers(s);}console.log(JSON.stringify({kind:'computer-selfplay',variant,turns,maxMs,result:checkersResult(s)}));}
