import fs from 'node:fs';
import crypto from 'node:crypto';
import path from 'node:path';
const variants=['glinski','mccooey','shafran','brusky','devasa','wellisch','hexdame','kruzno'];
for(const v of variants){const bank=JSON.parse(fs.readFileSync('/tmp/ion070-puzzles/'+v+'.json','utf8'));for(const p of bank.puzzles){delete p.sourceState;for(const view of[p.position,...p.answers.map((a:any)=>a.after)])for(const m of view.legalMoves){delete m.changes;delete m.fromNotation;delete m.toNotation;}}
 const name=v[0].toUpperCase()+v.slice(1);fs.writeFileSync('cloud/floot/helpers/daily'+name+'Puzzles.tsx',"// Generated by tests/puzzles/generate.cpp or generate-checkers.mts; validated against the shared rules.\nimport type {PuzzleBank} from './dailyPuzzleTypes';\nexport const dailyPuzzleData:PuzzleBank="+JSON.stringify(bank)+";\n");console.log(v,bank.puzzles.length);}
const files=(dir:string):string[]=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?files(path.join(dir,e.name)):[path.join(dir,e.name)]),hash=(s:string|Buffer)=>crypto.createHash('sha256').update(s).digest('hex');
const sources=[...files('shared/include'),...files('shared/src'),...files('shared/variants'),'engines/engine-1/protocol.cpp','cloud/floot/helpers/checkersRules.tsx'].filter(p=>/\.(cpp|hpp|tsx)$/.test(p)).sort(),banks=Object.fromEntries(variants.map(v=>{const p='cloud/floot/helpers/daily'+v[0].toUpperCase()+v.slice(1)+'Puzzles.tsx';return[p,hash(fs.readFileSync(p))];}));
fs.writeFileSync('tests/puzzles/manifest.json',JSON.stringify({sourceFingerprint:hash(sources.map(p=>p+'\0'+fs.readFileSync(p,'utf8')).join('\0')),sources,banks,positions:512,goals:Object.fromEntries(variants.map(v=>[v,v==='wellisch'?'king':v==='hexdame'?'promote':v==='kruzno'?'win':'mate']))},null,2)+'\n');
